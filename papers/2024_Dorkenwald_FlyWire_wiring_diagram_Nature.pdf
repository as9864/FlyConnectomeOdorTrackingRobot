               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <author:name>Alexander Shakeel Bates</author:name>
                  <author:orcid>http://orcid.org/0000-0002-1195-0445</author:orcid>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <author:name>Nils Eckstein</author:name>
                  <author:orcid>http://orcid.org/0000-0003-2226-8174</author:orcid>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <author:name>Jan Funke</author:name>
                  <author:orcid>http://orcid.org/0000-0003-4388-7783</author:orcid>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <author:name>Forrest Collman</author:name>
                  <author:orcid>http://orcid.org/0000-0002-0280-7022</author:orcid>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <author:name>Davi D. Bock</author:name>
                  <author:orcid>http://orcid.org/0000-0002-8218-7926</author:orcid>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <author:name>Gregory S. X. E. Jefferis</author:name>
                  <author:orcid>http://orcid.org/0000-0002-0587-9355</author:orcid>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <author:name>H. Sebastian Seung</author:name>
                  <author:orcid>http://orcid.org/0000-0002-8591-6733</author:orcid>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <author:name>Mala Murthy</author:name>
